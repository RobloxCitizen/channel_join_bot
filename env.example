# Токен бота от @BotFather
BOT_TOKEN=

# ID закрытого канала (например -1001234567890).
# Бот должен быть админом канала с правом "Приглашать пользователей".
CHANNEL_ID=-1001234567890

# Инвайт-ссылка канала, созданная с включённой опцией
# "Заявки на вступление" (Join Requests). Например https://t.me/+AbCdEfGh
CHANNEL_URL=https://t.me/+AbCdEfGhIjKlMnOp

# Необязательные настройки
OFFER_URL=https://t.me/your_offer_link
FIRST_PHOTO=app/assets/first.jpg
SECOND_PHOTO=app/assets/second.jpg
